+/**
+ * UTF-8 without iconv.
+ *
+ * glibc's iconv resolves every conversion through a module database it reads from
+ * /usr/lib/<triple>/gconv at run time, and loads the converters it names with dlopen. [CharsetIconv]
+ * pivots through UTF-16, so UTF-16.so is on the path of every conversion, UTF-8 included — measured:
+ * with that one module and the database present and nothing else, UTF-8 works; with the database
+ * present and no modules, it does not. So the most common charset in the library depends on what the
+ * runtime image happens to carry, and in an image that carries no gconv tree `iconv_open("UTF-8", …)`
+ * fails with EINVAL — while the Kotlin/Native standard library encodes and decodes UTF-8 itself,
+ * without libc.
+ */
+private object CharsetUtf8 : Charset("UTF-8") {
+    override fun newEncoder(): CharsetEncoder = CharsetEncoderImpl(this)
+    override fun newDecoder(): CharsetDecoder = CharsetDecoderImpl(this)
+}
+
+/**
+ * ISO-8859-1 without iconv, for the same reason as [CharsetUtf8] and with a shorter argument: the
+ * encoding is a one-to-one map between the 256 byte values and the first 256 code points, so there is
+ * nothing for libc to do. Ktor reaches for it on paths a service does not choose — the
+ * `Sec-WebSocket-Accept` digest and OAuth2's Basic credentials are both built through it — so leaving
+ * it on iconv would keep WebSocket and OAuth2 servers tied to the runtime image's gconv tree.
+ */
+private object CharsetIso88591 : Charset("ISO-8859-1") {
+    override fun newEncoder(): CharsetEncoder = CharsetEncoderImpl(this)
+    override fun newDecoder(): CharsetDecoder = CharsetDecoderImpl(this)
+}
+
+/**
+ * The index just past the last complete UTF-8 sequence in `[startIndex, endIndex)`.
+ *
+ * A segment can end in the middle of a multi-byte character, and the caller has to leave those bytes
+ * in the source rather than decode them. A sequence is at most four bytes, so at most three trailing
+ * bytes are ever held back.
+ */
+private fun lastCompleteUtf8Boundary(data: ByteArray, startIndex: Int, endIndex: Int): Int {
+    var i = endIndex - 1
+    val limit = maxOf(startIndex, endIndex - 4)
+    while (i >= limit) {
+        val b = data[i].toInt() and 0xFF
+        if (b and 0xC0 != 0x80) {
+            val needed = when {
+                b and 0x80 == 0x00 -> 1
+                b and 0xE0 == 0xC0 -> 2
+                b and 0xF0 == 0xE0 -> 3
+                b and 0xF8 == 0xF0 -> 4
+                else -> 1 // malformed lead byte: let the decoder report it
+            }
+            return if (i + needed <= endIndex) endIndex else i
+        }
+        i--
+    }
+    return endIndex
+}
+
