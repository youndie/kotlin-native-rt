+/**
+ * The UTF-8 half of [decode], without iconv.
+ *
+ * Keeps the contract of the iconv path: returns the number of BYTES consumed, stops at [max] bytes,
+ * appends decoded characters to [dst], and throws [MalformedInputException] on input that is not
+ * valid UTF-8. Only complete sequences are consumed, so a character split across two segments is
+ * left in the source for the next call — the same consolidation the iconv path performs when a
+ * segment boundary falls inside a character.
+ */
+@OptIn(UnsafeIoApi::class, InternalIoApi::class)
+private fun decodeUtf8(input: Source, dst: Appendable, max: Int): Int {
+    var copied = 0
+    while (!input.exhausted() && copied < max) {
+        var bytesConsumed = 0
+        var headSegmentSize = 0
+        var cutByBudget = false
+        UnsafeBufferOperations.readFromHead(input.buffer) { data, startIndex, endIndex ->
+            headSegmentSize = endIndex - startIndex
+            // Overflow-safe: `startIndex + (max - copied)` goes negative when `max` is near
+            // Int.MAX_VALUE, which is how readText passes it, and `startIndex` is not zero.
+            val budget = max - copied
+            val budgetEnd = if (budget >= endIndex - startIndex) endIndex else startIndex + budget
+            cutByBudget = budgetEnd < endIndex
+            val end = lastCompleteUtf8Boundary(data, startIndex, budgetEnd)
+            if (end > startIndex) {
+                val text = try {
+                    data.decodeToString(startIndex, end, throwOnInvalidSequence = true)
+                } catch (cause: CharacterCodingException) {
+                    throw MalformedInputException("Malformed or unmappable bytes at input")
+                }
+                dst.append(text)
+            }
+            val consumed = end - startIndex
+            copied += consumed
+            bytesConsumed = consumed
+            consumed
+        }
+
+        // THE BUDGET IS NOT AN ERROR. `max` can land inside a multi-byte character, and then there is
+        // nothing wrong with the input — there is simply no whole character left within what the
+        // caller asked for. Stopping is the answer; throwing would turn a short read into a failure.
+        if (cutByBudget && bytesConsumed == 0) break
+
+        if (bytesConsumed == 0) {
+            if (input.buffer.size > headSegmentSize.toLong()) {
+                // Incomplete multi-byte character at a segment boundary: consolidate and retry.
+                val remaining = input.readByteArray()
+                input.buffer.write(remaining)
+                continue
+            }
+            throw MalformedInputException("Incomplete or truncated byte sequence at input")
+        }
+    }
+    return copied
+}
+
+/**
+ * The ISO-8859-1 half of [decode], without iconv. Simpler than [decodeUtf8] because one byte is one
+ * character: no sequence can straddle a segment boundary, so nothing is ever held back.
+ */
+@OptIn(UnsafeIoApi::class, InternalIoApi::class)
+private fun decodeLatin1(input: Source, dst: Appendable, max: Int): Int {
+    var copied = 0
+    while (!input.exhausted() && copied < max) {
+        var bytesConsumed = 0
+        UnsafeBufferOperations.readFromHead(input.buffer) { data, startIndex, endIndex ->
+            val budget = max - copied
+            val end = if (budget >= endIndex - startIndex) endIndex else startIndex + budget
+            val consumed = decodeISO88591(data, startIndex, end, dst)
+            copied += consumed
+            bytesConsumed = consumed
+            consumed
+        }
+        if (bytesConsumed == 0) break
+    }
+    return copied
+}
