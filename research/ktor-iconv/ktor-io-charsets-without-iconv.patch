+/**
+ * Decodes `[startIndex, endIndex)` of [data] as ISO-8859-1 into [dst], returning the number of bytes
+ * read.
+ *
+ * Every one of the 256 byte values maps to the code point of the same number, so this cannot fail and
+ * — unlike a multi-byte encoding — has no sequence that a buffer boundary can split.
+ */
+internal fun decodeISO88591(data: ByteArray, startIndex: Int, endIndex: Int, dst: Appendable): Int {
+    for (index in startIndex until endIndex) {
+        dst.append((data[index].toInt() and 0xff).toChar())
+    }
+    return endIndex - startIndex
+}
