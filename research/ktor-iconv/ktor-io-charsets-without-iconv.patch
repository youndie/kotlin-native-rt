+++ b/ktor-io/linux/test/CharsetErrorSemanticsTest.kt
@@ -0,0 +1,155 @@
+/*
+ * Copyright 2014-2026 JetBrains s.r.o and contributors. Use of this source code is governed by the Apache 2.0 license.
+ */
+
+// ABOUTME: What the linux charsets do with input that is malformed, unmappable, or cut in half.
+// ABOUTME: These are the cases where a hand-written codec and iconv are easiest to make disagree.
+
+import io.ktor.utils.io.charsets.*
+import kotlinx.io.*
+import kotlin.test.*
+
+/**
+ * Error semantics of the `linux` charsets.
+ *
+ * Deliberately in `linux/test` and not in `jvmAndPosix/test`: these assertions are platform
+ * behaviour, not library contract. The JVM replaces an unmappable character with `?` and a malformed
+ * byte with U+FFFD; `linux` throws on both, because that is what iconv did and what this must keep
+ * doing. Asserting it anywhere wider turns a platform difference into a failing build.
+ *
+ * All but the two budget tests pass against the iconv implementation as well, which is the point of
+ * them: they pin behaviour that must not change. The two that do not are the one deliberate
+ * difference, documented on them.
+ */
+class CharsetErrorSemanticsTest {
+
+    // ---- malformed input: throw, never substitute ------------------------------------------------
+
+    /**
+     * `ByteArray.decodeToString()` substitutes U+FFFD by default, which would be a silent behaviour
+     * change from iconv's EILSEQ. The replacement passes `throwOnInvalidSequence = true` instead.
+     */
+    @Test
+    fun rejectsMalformedUtf8RatherThanSubstituting() {
+        // 0xC3 announces a two-byte sequence; 0x28 is not a continuation byte.
+        val cases = listOf(
+            byteArrayOf(0x61, 0xC3.toByte(), 0x28, 0x62), // bad continuation
+            byteArrayOf(0x61, 0x80.toByte(), 0x62), // lone continuation byte
+            byteArrayOf(0x61, 0xC0.toByte(), 0xAF.toByte(), 0x62), // overlong encoding of '/'
+            byteArrayOf(0x61, 0xED.toByte(), 0xA0.toByte(), 0x80.toByte()), // UTF-16 surrogate
+            byteArrayOf(0x61, 0xF5.toByte(), 0x80.toByte(), 0x80.toByte(), 0x80.toByte()), // > U+10FFFF
+        )
+        for ((index, bytes) in cases.withIndex()) {
+            val out = StringBuilder()
+            assertFailsWith<MalformedInputException>("case $index") {
+                Charsets.UTF_8.newDecoder().decode(Buffer().apply { write(bytes) }, out, Int.MAX_VALUE)
+            }
+            assertFalse('�' in out, "case $index must not substitute a replacement character")
+        }
+    }
+
+    // ---- split sequences: hold back the tail, never half-decode -----------------------------------
+
+    /**
+     * iconv answers EINVAL for a trailing partial sequence and consumes nothing, leaving the caller to
+     * bring more bytes. When there are no more bytes the decoder has to say so rather than emit half a
+     * character, so a truncated tail at the end of input is an error and not a silent truncation.
+     */
+    @Test
+    fun rejectsATruncatedSequenceAtTheEndOfInput() {
+        val truncations = listOf(
+            "abé".encodeToByteArray().dropLast(1), // two-byte character missing its tail
+            "ab€".encodeToByteArray().dropLast(1), // three-byte, one byte short
+            "ab€".encodeToByteArray().dropLast(2), // three-byte, two bytes short
+            "ab😀".encodeToByteArray().dropLast(1), // four-byte, one byte short
+        )
+        for ((index, bytes) in truncations.withIndex()) {
+            assertFailsWith<MalformedInputException>("truncation $index") {
+                Charsets.UTF_8.newDecoder()
+                    .decode(Buffer().apply { write(bytes.toByteArray()) }, StringBuilder(), Int.MAX_VALUE)
+            }
+        }
+    }
+
+    /**
+     * `max` is documented as the maximum number of BYTES to decode, and it can land inside a
+     * multi-byte character. Then there is no whole character left inside the budget, and the decoder
+     * stops: it neither decodes half a character nor reports an error, because the input is fine.
+     *
+     * THIS IS THE ONE PLACE THE REPLACEMENT DOES NOT REPRODUCE ICONV, and it is deliberate. Measured
+     * on the iconv implementation, this same call returns "abécd" and 6: iconv is handed the whole
+     * segment and `max` is only consulted between segments, so a byte budget shorter than a segment
+     * does not bound the result at all — whether or not it lands inside a character. Honouring the
+     * documented contract seemed better than reproducing that; if you would rather keep it
+     * bug-for-bug, this and the test below are the two to invert.
+     */
+    @Test
+    fun aByteBudgetThatEndsInsideACharacterStopsWithoutFailing() {
+        val text = "abécd" // 'é' occupies bytes 2 and 3
+        val source = Buffer().apply { write(text.encodeToByteArray()) }
+        val out = StringBuilder()
+
+        val consumed = Charsets.UTF_8.newDecoder().decode(source, out, max = 3)
+
+        assertEquals("ab", out.toString(), "half of 'é' must not be decoded")
+        assertEquals(2, consumed, "only the bytes of whole characters count as consumed")
+    }
+
+    /**
+     * A budget that falls exactly on a character boundary — and iconv does not honour this one either.
+     * Measured: `max = 4` on the same input also returns `abécd` and 6, so iconv ignores the budget
+     * within a segment altogether, not merely when it lands inside a character. The replacement
+     * honours it in both cases.
+     */
+    @Test
+    fun aByteBudgetOnACharacterBoundaryConsumesExactlyThatMuch() {
+        val source = Buffer().apply { write("abécd".encodeToByteArray()) }
+        val out = StringBuilder()
+
+        val consumed = Charsets.UTF_8.newDecoder().decode(source, out, max = 4)
+
+        assertEquals("abé", out.toString())
+        assertEquals(4, consumed)
+    }
+
+    // ---- unmappable output ------------------------------------------------------------------------
+
+    /** ISO-8859-1 holds 256 code points; anything above that is an error, not a `?`. */
+    @Test
+    fun refusesACharacterIso88591CannotRepresent() {
+        assertFailsWith<MalformedInputException> {
+            Charsets.ISO_8859_1.newEncoder().encodeToByteArray("café €", 0, 6)
+        }
+    }
+
+    /** And the 256 it does hold are all encodable, so the check above is not over-eager. */
+    @Test
+    fun acceptsTheHighestCharacterIso88591CanRepresent() {
+        val encoded = Charsets.ISO_8859_1.newEncoder().encodeToByteArray("ÿ", 0, 1)
+        assertEquals(1, encoded.size)
+        assertEquals(0xFF, encoded[0].toInt() and 0xFF)
+    }
+
+    // ---- unpaired surrogates on the ENCODE path --------------------------------------------------
+
+    /**
+     * `String.encodeToByteArray()` replaces an unpaired surrogate with U+FFFD unless asked not to,
+     * which would be a silent behaviour change: measured on 3.5.2, the iconv path throws here.
+     * Reachable from ordinary code — a substring that cut a surrogate pair in half.
+     */
+    @Test
+    fun rejectsAnUnpairedSurrogateRatherThanSubstituting() {
+        for (input in listOf("a\uD800b", "a\uDC00b", "\uD83D", "x\uDE00")) {
+            assertFailsWith<MalformedInputException>("input=$input") {
+                Charsets.UTF_8.newEncoder().encodeToByteArray(input, 0, input.length)
+            }
+        }
+    }
+
+    /** A properly paired surrogate is not affected, so the check above is not over-eager. */
+    @Test
+    fun encodesAProperlyPairedSurrogate() {
+        val encoded = Charsets.UTF_8.newEncoder().encodeToByteArray("a\uD83D\uDE00b", 0, 4)
+        assertEquals("a\uD83D\uDE00b".encodeToByteArray().toList(), encoded.toList())
+    }
+}
