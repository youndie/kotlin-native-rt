@@ -0,0 +1,59 @@
+/*
+ * Copyright 2014-2026 JetBrains s.r.o and contributors. Use of this source code is governed by the Apache 2.0 license.
+ */
+
+// ABOUTME: A multi-byte UTF-8 character that straddles a buffer segment boundary must decode whole.
+// ABOUTME: Without a boundary check the decoder consumes half a character and corrupts the output.
+
+import io.ktor.utils.io.charsets.*
+import kotlinx.io.*
+import kotlin.test.*
+
+class Utf8SegmentBoundaryTest {
+
+    /**
+     * kotlinx-io segments are 8192 bytes, so a source longer than that is delivered to the decoder in
+     * more than one chunk. This places a two-byte character across the seam: 8191 ASCII bytes, then
+     * `é`, whose lead byte is the last byte of the first segment and whose continuation byte is the
+     * first byte of the second.
+     *
+     * The iconv path handles this by consuming nothing and asking for the segments to be consolidated.
+     * Any replacement has to do the same; decoding the lead byte on its own is malformed input.
+     */
+    @Test
+    fun decodesACharacterSplitAcrossSegments() {
+        val head = "a".repeat(8191)
+        val text = head + "é" + "b".repeat(16)
+        val bytes = text.encodeToByteArray()
+        assertEquals(8191, head.encodeToByteArray().size, "the seam must fall inside the character")
+
+        val source = Buffer().apply { write(bytes) }
+        val out = StringBuilder()
+        Charsets.UTF_8.newDecoder().decode(source, out, Int.MAX_VALUE)
+
+        assertEquals(text, out.toString())
+    }
+
+    /** The same with a four-byte character, which is the widest sequence and the most to hold back. */
+    @Test
+    fun decodesAFourByteCharacterSplitAcrossSegments() {
+        for (offset in 8189..8191) {
+            val head = "a".repeat(offset)
+            val text = head + "😀" + "b".repeat(16) // U+1F600, four bytes in UTF-8
+            val source = Buffer().apply { write(text.encodeToByteArray()) }
+            val out = StringBuilder()
+            Charsets.UTF_8.newDecoder().decode(source, out, Int.MAX_VALUE)
+            assertEquals(text, out.toString(), "split at offset $offset")
+        }
+    }
+
+    /** The same unbounded-budget-at-a-non-zero-offset case for UTF-8. */
+    @Test
+    fun decodesFromANonZeroOffsetWithAnUnboundedBudget() {
+        val packet = kotlinx.io.Buffer().apply { write("xAB\u00e9CD".encodeToByteArray()) }
+        packet.readByte()
+        val out = StringBuilder()
+        Charsets.UTF_8.newDecoder().decode(packet, out, Int.MAX_VALUE)
+        assertEquals("AB\u00e9CD", out.toString())
+    }
+}
