@@ -0,0 +1,71 @@
+/*
+ * Copyright 2014-2026 JetBrains s.r.o and contributors. Use of this source code is governed by the Apache 2.0 license.
+ */
+
+// ABOUTME: ISO-8859-1 encodes and decodes as a one-to-one byte/code-point map, in both directions,
+// ABOUTME: across buffer segments, and reports a character it cannot represent.
+
+import io.ktor.utils.io.charsets.*
+import io.ktor.utils.io.core.*
+import kotlinx.io.*
+import kotlin.test.*
+
+class Iso88591WithoutIconvTest {
+
+    @Test
+    fun encodesEveryByteValue() {
+        val text = (0..0xff).map { it.toChar() }.joinToString("")
+        val bytes = text.toByteArray(Charsets.ISO_8859_1)
+        assertEquals(256, bytes.size)
+        for (i in 0..0xff) {
+            assertEquals(i, bytes[i].toInt() and 0xff, "byte $i")
+        }
+    }
+
+    @Test
+    fun decodesEveryByteValue() {
+        val bytes = ByteArray(256) { it.toByte() }
+        val out = StringBuilder()
+        val consumed = Charsets.ISO_8859_1.newDecoder().decode(
+            kotlinx.io.Buffer().apply {
+                write(bytes)
+            },
+            out,
+            Int.MAX_VALUE
+        )
+        assertEquals(256, consumed)
+        assertEquals((0..0xff).map { it.toChar() }.joinToString(""), out.toString())
+    }
+
+    /** More than one kotlinx-io segment, so the decoder's loop runs more than once. */
+    @Test
+    fun decodesAcrossSegments() {
+        val bytes = ByteArray(20_000) { (it % 256).toByte() }
+        val out = StringBuilder()
+        val consumed = Charsets.ISO_8859_1.newDecoder().decode(
+            kotlinx.io.Buffer().apply {
+                write(bytes)
+            },
+            out,
+            Int.MAX_VALUE
+        )
+        assertEquals(20_000, consumed)
+        assertEquals(20_000, out.length)
+        assertEquals((19_999 % 256).toChar(), out[19_999])
+    }
+
+    /**
+     * `readText` passes `Int.MAX_VALUE` as the budget. If the budget is added to the segment's start
+     * offset to find the end, that overflows as soon as anything has already been read from the
+     * buffer, and the decoder walks backwards. Every other test here starts at offset zero and cannot
+     * see it.
+     */
+    @Test
+    fun decodesFromANonZeroOffsetWithAnUnboundedBudget() {
+        val packet = kotlinx.io.Buffer().apply { write(byteArrayOf(0x41, 0xE9.toByte(), 0x42, 0x43)) }
+        packet.readByte()
+        val out = StringBuilder()
+        Charsets.ISO_8859_1.newDecoder().decode(packet, out, Int.MAX_VALUE)
+        assertEquals("\u00e9BC", out.toString())
+    }
+}
