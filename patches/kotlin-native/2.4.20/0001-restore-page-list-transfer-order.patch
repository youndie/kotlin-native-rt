diff -ruN a/kotlin-native/runtime/src/alloc/custom/cpp/PageStore.hpp b/kotlin-native/runtime/src/alloc/custom/cpp/PageStore.hpp
--- a/kotlin-native/runtime/src/alloc/custom/cpp/PageStore.hpp
